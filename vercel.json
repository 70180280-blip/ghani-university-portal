{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "redirects": [
    {
      "source": "/teacher",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/slate",
      "destination": "/",
      "permanent": false
    }
  ]
}
